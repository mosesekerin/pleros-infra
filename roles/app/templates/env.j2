# {{ ansible_managed }}
# Generated from the encrypted vault. Do not edit on the server: edit the vault and re-run `make app`.
# Values are single-quoted (taken literally by both Docker Compose and Next.js).
{% for key, value in vault_app_env | dictsort %}
{% set v = value | string %}
{% if "'" not in v and "\n" not in v %}
{{ key }}='{{ v }}'
{% else %}
{{ key }}={{ v | to_json(ensure_ascii=False) }}
{% endif %}
{% endfor %}
